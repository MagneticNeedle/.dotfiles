# Python bytecode from scripts under */.local/bin
__pycache__/
*.py[cod]

# Editor / OS scratch
*.swp
*~
.DS_Store
*.bak

# Real binaries and shims that installers (uv, pipx) drop into a stowed
# ~/.local/bin (uv alone is 63M). install.sh stows with --no-folding so this
# shouldn't happen anymore, but keep them out of the repo regardless.
**/.local/bin/uv
**/.local/bin/uvx
**/.local/bin/python3*
/.claude
