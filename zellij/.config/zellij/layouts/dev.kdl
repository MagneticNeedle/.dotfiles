// Generic dev layout: claude / run / git
// Panes inherit the cwd from wherever `zellij` is launched (the `zj` script cd's
// into the project first), so this layout is reusable across projects.
layout {
    // every tab gets a tab bar on top and a compact status bar on the bottom
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
    }

    tab name="claude" focus=true {
        pane command="claude"
    }

    tab name="run" {
        // plain interactive shell for `uv run ...`, `uv sync`, tests, etc.
        pane
    }

    tab name="git" {
        pane command="lazygit"
    }
}
